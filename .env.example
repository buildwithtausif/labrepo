# ============================================================
# LabRepo — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Core App Settings ---
# ENV: Determines the environment context ('development' or 'production'). In development, some security/admin checks might be bypassed.
ENV=development

# PUBLIC_SITE_URL: The base public-facing URL of the frontend. Used for canonical/OG SEO links and redirects.
PUBLIC_SITE_URL=http://localhost:4321

# HOST: The network interface the frontend server will bind to. Use 0.0.0.0 for all interfaces (useful in Docker).
HOST=0.0.0.0

# PORT: The port the frontend server will run on.
PORT=4321


# --- API Server ---
# API_PORT: The port the backend API server will run on.
API_PORT=3001

# API_HOST: The network interface the backend API server will bind to.
API_HOST=0.0.0.0

# CORS_ORIGINS: Comma-separated list of allowed origins that can make cross-origin requests to the API.
CORS_ORIGINS=https://labrepo.app,http://localhost:4321,http://localhost:3000,http://127.0.0.1:4321,http://127.0.0.1:3000

# INTERNAL_API_URL: Internal URL used by the frontend SSR to call the backend API (especially useful in Docker networks).
INTERNAL_API_URL=http://localhost:3001

# PUBLIC_API_URL: Publicly accessible API URL for client-side frontend fetches.
PUBLIC_API_URL=http://localhost:3001

# API_URL: General/fallback API URL used in some components and layouts.
API_URL=http://localhost:3001


# --- Clerk Authentication ---
# PUBLIC_CLERK_PUBLISHABLE_KEY: Clerk frontend publishable key for client-side auth.
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# CLERK_SECRET_KEY: Clerk backend secret key for verifying tokens and API access.
CLERK_SECRET_KEY=sk_test_your_key_here


# --- Admin & Authorization ---
# ADMIN_USER_ID: User ID of the primary admin. Grants admin dashboard access and bypasses some limits.
ADMIN_USER_ID=your_clerk_user_id

# CLERK_ADMIN_USER_ID: Legacy or alias for the admin user ID, used similarly to ADMIN_USER_ID.
CLERK_ADMIN_USER_ID=your_clerk_user_id


# --- Database (PostgreSQL) ---
# DATABASE_URL: Connection string for the PostgreSQL database.
# For self-hosted (Docker Compose):
DATABASE_URL=postgresql://labrepo:labrepo_secret@postgres:5432/labrepo
# For managed (Neon, Supabase, etc.):
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require


# --- Storage (MinIO / S3) ---
# STORAGE_DRIVER: Defines the storage adapter to use. "minio" | "s3" | "mock" (default: mock).
STORAGE_DRIVER=minio

# AWS_ACCESS_KEY: Access key ID for S3/MinIO.
AWS_ACCESS_KEY=minioadmin

# AWS_SECRET_KEY: Secret access key for S3/MinIO.
AWS_SECRET_KEY=minioadmin

# AWS_BUCKET: The S3/MinIO bucket name where files will be stored.
AWS_BUCKET=labrepo-storage

# AWS_REGION: The AWS region for the bucket.
AWS_REGION=us-east-1

# AWS_ENDPOINT: Custom S3 API endpoint URL (e.g., used for MinIO).
AWS_ENDPOINT=http://minio:9000

# MinIO Console (Docker only)
# MINIO_ROOT_USER: Default root username for the MinIO Docker instance.
MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD: Default root password for the MinIO Docker instance.
MINIO_ROOT_PASSWORD=minioadmin


# --- Limits, Security & App Features (Optional Overrides) ---
# Uncomment to override defaults:

# MAX_UPLOAD_SIZE: Maximum file upload size in bytes (default: 26214400, which is 25 MB).
# MAX_UPLOAD_SIZE=26214400


# UPLOADS_PER_MINUTE: Maximum number of file uploads allowed per minute per user (default: 20).
# UPLOADS_PER_MINUTE=20

# MAX_REPOSITORIES: Maximum number of repositories a single user can create (default: 50).
# MAX_REPOSITORIES=50

# LOGIN_RATE_LIMIT: Maximum login attempts allowed per rate limit window (default: 10).
# LOGIN_RATE_LIMIT=10

# ALLOWED_FILE_TYPES: Comma-separated list of additional allowed file extensions globally (e.g., py,js,ts).
# ALLOWED_FILE_TYPES=py,js,ts,env,txt,csv,md,pdf
